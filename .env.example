HOST=127.0.0.1
PORT=8080
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_hub
DB_PASSWORD="your_password"
DB_SSLMODE=disable

#generate a new JWT SERCET using a command in terminal, \
#avoid writing it yourself, it should be at least 64 byte
JWT_SECRET=

# Keep disabled until the private Azure container and account credentials exist.
MEDIA_ENABLED=false
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER_NAME=your_private_container
# Account root URL, or the URL of the configured container. No SAS query string.
AZURE_STORAGE_BLOB_URL=https://your_storage_account.blob.core.windows.net/
# Optional absolute path if ffmpeg is not on PATH (for example C:/ffmpeg/bin/ffmpeg.exe).
FFMPEG_PATH=ffmpeg
# Optimization trigger, not a guaranteed output size. Default: 1 MiB.
MEDIA_COMPRESSION_THRESHOLD_BYTES=1048576

# Valkey container authentication. Generate a separate secret: openssl rand -hex 32
VALKEY_PASSWORD=
# Avoid a local Redis/Valkey port conflict. Containers use valkey:6379.
VALKEY_PORT=6380
